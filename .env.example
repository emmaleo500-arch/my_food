# Copy this file to `.env` and fill in the real values. Never commit `.env`.

# Gmail address orders are sent FROM (needs 2-Step Verification + an App Password).
EMAIL_USER=

# 16-character Gmail App Password, no spaces.
# https://myaccount.google.com/apppasswords
EMAIL_PASS=

# Inbox that receives every order.
TO_EMAIL=

# Only needed when the SMTP provider is not Gmail.
# SMTP_HOST=
# SMTP_PORT=

# Password for the shop admin panel (add/edit products). Change this.
SHOP_ADMIN_PASSWORD=

# Port the server listens on. Render sets this automatically; 3000 is fine locally.
PORT=3000