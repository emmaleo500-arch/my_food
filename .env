# Copy this file to ".env" and fill in your own values. Never commit the real ".env" file.

# The Gmail address the server sends FROM (needs an App Password, not your normal password —
# see the "Sending email" section in README.md for how to create one).
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=your16characterapppassword

# The inbox that should receive every order. Defaults to the kitchen's address if left out.
TO_EMAIL=nkrumahvida61@gmail.com

# Port the server runs on locally.
PORT=3000

# Optional: only set these if you want to use a non-Gmail SMTP provider
# (e.g. Outlook, Zoho, SendGrid SMTP, your host's mail server) instead of Gmail.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
